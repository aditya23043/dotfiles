hi clear
let g:colors_name = 'terminal_green'
set background=dark
set notermguicolors
set cursorline

hi Normal       ctermfg=7  ctermbg=NONE
hi Comment      ctermfg=8  cterm=italic
hi Constant     ctermfg=6
hi String       ctermfg=2
hi Identifier   ctermfg=10
hi Statement    ctermfg=10 cterm=bold
hi PreProc      ctermfg=5
hi Type         ctermfg=2  cterm=bold
hi Special      ctermfg=3
hi Error        ctermfg=7  ctermbg=1
hi Visual       ctermbg=0  ctermfg=10
hi CursorLine   cterm=NONE ctermbg=NONE
hi LineNr       ctermfg=8
hi EndOfBuffer       ctermfg=8
hi CursorLineNr ctermfg=10
hi Search       ctermfg=0  ctermbg=10
hi StatusLine   ctermbg=0  ctermfg=10
hi StatusLineNC ctermfg=0  ctermbg=NONE
hi VertSplit    ctermfg=8 ctermbg=NONE
hi SignColumn ctermbg=NONE
hi Folded ctermbg=NONE ctermfg=8
hi CocMenuSel ctermbg=7 ctermfg=0
hi Pmenu ctermbg=NONE ctermfg=7
hi CocSearch ctermfg=10
