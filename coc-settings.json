{
  "clangd.arguments": [
    "--completion-style=detailed",
    "--function-arg-placeholders=true",
    "--header-insertion=never",
    "--all-scopes-completion"
  ], "suggest.noselect": true,
  "coc.preferences.formatOnSave": false,
  "zig.path": "/opt/homebrew/bin/zls",
  "diagnostic.virtualText": true,
  "diagnostic.virtualTextCurrentLineOnly": true,
  "diagnostic.virtualTextPrefix": " ▸ ",
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,
  "java.import.gradle.offline.enabled": false,
  "java.configuration.updateBuildConfiguration": "interactive",
  "java.signatureHelp.description.enabled": true,
  "java.codeGeneration.generateComments": true,
  "java.saveActions.organizeImports": true,
  "java.format.enabled": true,
  "java.referencesCodeLens.enabled": true,
  "java.implementationsCodeLens.enabled": true,
  "codeLens.enable": true,
  "codeLens.separator": "▸",
  "codeLens.display": true,
  "inlayHint.enable": true,
  "inlayHint.refreshOnInsertMode": true,
  "flutter.sdk.path": "/opt/flutter",
  "flutter.lsp.initialization.closingLabels": true,
  "git.enableGutters": false,
  "markdown-preview-enhanced.liveUpdate": true,
  "snippets.ultisnips.pythonPrompt": false,
  "tsserver.log": "verbose",
  "tsserver.trace.server": "verbose",
  "lua.enable": true,
  "Lua.codeLens.enable": true,
  "languageserver": {
    "typst": {
      "command": "tinymist",
      "filetypes": ["typst"],
      "rootPatterns": ["main.typ", ".git"]
    },
    "swift": {
        "command": "sourcekit-lsp",
        "filetypes": ["swift"],
        "rootPatterns": ["Package.swift", ".git", "*.xcodeproj", "*.xcworkspace"]
    }
  }
}
